		{
			"name": "3. Exams & Question Creation (Admin / Student)",
			"item": [
				{
					"name": "POST Create Exam (Admin Only)",
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Content-Type", "value": "application/json" },
							{ "key": "Authorization", "value": "Bearer {{adminToken}}" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"title\": \"Data Structures Midterm Exam\",\n  \"duration_minutes\": 60,\n  \"total_marks\": 50\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/exams/create",
							"host": ["{{baseUrl}}"],
							"path": ["api", "exams", "create"]
						}
					}
				},
				{
					"name": "POST Add Question to Exam (Admin Only)",
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Content-Type", "value": "application/json" },
							{ "key": "Authorization", "value": "Bearer {{adminToken}}" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"question_text\": \"What is the time complexity of binary search?\",\n  \"options\": [\n    { \"text\": \"O(N)\" },\n    { \"text\": \"O(log N)\" },\n    { \"text\": \"O(N^2)\" },\n    { \"text\": \"O(1)\" }\n  ],\n  \"correct_answer\": 1,\n  \"marks\": 2\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/exams/{{examId}}/questions",
							"host": ["{{baseUrl}}"],
							"path": ["api", "exams", "{{examId}}", "questions"]
						}
					}
				},
				{
					"name": "GET Exam Questions (Student Protected)",
					"request": {
						"method": "GET",
						"header": [
							{ "key": "Authorization", "value": "Bearer {{studentToken}}" }
						],
						"url": {
							"raw": "{{baseUrl}}/api/exams/{{examId}}/questions",
							"host": ["{{baseUrl}}"],
							"path": ["api", "exams", "{{examId}}", "questions"]
						}
					}
				},
				{
					"name": "POST Start Exam (Student Only)",
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Content-Type", "value": "application/json" },
							{ "key": "Authorization", "value": "Bearer {{studentToken}}" }
						],
						"url": {
							"raw": "{{baseUrl}}/api/exams/{{examId}}/start",
							"host": ["{{baseUrl}}"],
							"path": ["api", "exams", "{{examId}}", "start"]
						}
					}
				}
			]
		},
		{
			"name": "4. Test Management & Sections",
			"item": [
				{
					"name": "POST Create Managed Test (Admin Only)",
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Content-Type", "value": "application/json" },
							{ "key": "Authorization", "value": "Bearer {{adminToken}}" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"title\": \"Computer Networks Quiz\",\n  \"category\": \"GATE Prep\",\n  \"description\": \"Assessment test for unit 1\",\n  \"durationMinutes\": 45,\n  \"maxAttempts\": 2\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/test-management/create",
							"host": ["{{baseUrl}}"],
							"path": ["api", "test-management", "create"]
						}
					}
				},
				{
					"name": "GET Test Details (Protected)",
					"request": {
						"method": "GET",
						"header": [
