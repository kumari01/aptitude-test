							{ "key": "Authorization", "value": "Bearer {{adminToken}}" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"targetType\": \"Selected\",\n  \"departments\": [\"CSE\", \"ECE\"],\n  \"batches\": [\"2021-2025\"],\n  \"studentRollNumbers\": [\"21A12A0501\"]\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/test-management/{{examId}}/target",
							"host": ["{{baseUrl}}"],
							"path": ["api", "test-management", "{{examId}}", "target"]
						}
					}
				},
				{
					"name": "POST Schedule Test (Admin Only)",
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Content-Type", "value": "application/json" },
							{ "key": "Authorization", "value": "Bearer {{adminToken}}" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"startAt\": \"2026-08-15T09:00:00.000Z\",\n  \"endAt\": \"2026-08-15T18:00:00.000Z\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/test-management/{{examId}}/schedule",
							"host": ["{{baseUrl}}"],
							"path": ["api", "test-management", "{{examId}}", "schedule"]
						}
					}
				},
				{
					"name": "POST Create Section (Admin Only)",
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Content-Type", "value": "application/json" },
							{ "key": "Authorization", "value": "Bearer {{adminToken}}" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"name\": \"Section A: Multiple Choice\",\n  \"displayOrder\": 1,\n  \"totalMarks\": 20\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/test-management/{{examId}}/sections",
							"host": ["{{baseUrl}}"],
							"path": ["api", "test-management", "{{examId}}", "sections"]
						}
					}
				},
				{
					"name": "POST Add Question to Section (Admin Only)",
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Content-Type", "value": "application/json" },
							{ "key": "Authorization", "value": "Bearer {{adminToken}}" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"questionId\": \"{{questionId}}\",\n  \"displayOrder\": 1,\n  \"marks\": 2\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/test-management/sections/{{sectionId}}/questions",
							"host": ["{{baseUrl}}"],
							"path": ["api", "test-management", "sections", "{{sectionId}}", "questions"]
						}
					}
				},
				{
					"name": "GET Assigned Tests for Student (Student Only)",
					"request": {
						"method": "GET",
						"header": [
							{ "key": "Authorization", "value": "Bearer {{studentToken}}" }
						],
						"url": {
							"raw": "{{baseUrl}}/api/test-management/student/assigned?rollNumber=21A12A0501",
							"host": ["{{baseUrl}}"],
							"path": ["api", "test-management", "student", "assigned"],
							"query": [
								{ "key": "rollNumber", "value": "21A12A0501" }
							]
						}
					}
				}
			]
		},
		{
			"name": "5. Answers & Attempt Execution (Student)",
			"item": [
