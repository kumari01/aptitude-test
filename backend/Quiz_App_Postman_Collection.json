	"item": [
		{
			"name": "1. System & Health",
			"item": [
				{
					"name": "GET Root Welcome Message",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/",
							"host": ["{{baseUrl}}"],
							"path": [""]
						}
					}
				},
				{
					"name": "GET Exam Router Health Check",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/exams/hello",
							"host": ["{{baseUrl}}"],
							"path": ["api", "exams", "hello"]
						}
					}
				}
			]
		},
		{
			"name": "2. Authentication",
			"item": [
				{
					"name": "POST Student Signup",
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Content-Type", "value": "application/json" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"username\": \"john_doe\",\n  \"rollno\": \"21A12A0501\",\n  \"email\": \"john_doe@sasi.ac.in\",\n  \"password\": \"Password123!\",\n  \"department\": \"CSE\",\n  \"batch\": \"2021-2025\",\n  \"section\": \"A\",\n  \"phone\": \"9876543210\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/auth/student/signup",
							"host": ["{{baseUrl}}"],
							"path": ["api", "auth", "student", "signup"]
						}
					}
				},
				{
					"name": "POST Student Login",
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Content-Type", "value": "application/json" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"rollno\": \"21A12A0501\",\n  \"password\": \"Password123!\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/auth/student/login",
