						"body": {
							"mode": "raw",
							"raw": "{\n  \"tabSwitchLimit\": 3,\n  \"enableProctoring\": true,\n  \"fullScreenRequired\": true,\n  \"randomizeQuestions\": true\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/test-management/{{examId}}/settings",
